QWidget {
    color: #dce8fa;
    font-size: 13px;
}
QMainWindow, QWidget#centralwidget {
    background: #0a101c;
}
QLabel { background: transparent; }
QLabel#labelTitle { font-size: 24px; font-weight: 600; color: #f0f5ff; }
QLabel#labelSubtitle { color: #8fa3bf; font-size: 12px; }
QLabel#labelMonogram {
    color: #89baff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #243d60, stop:1 #122138);
    border: 1px solid #38547c;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
}
QLabel#labelVariant {
    color: #9db4d5;
    border: 1px solid #293c57;
    border-radius: 11px;
    padding: 8px 13px;
    font-size: 11px;
    font-weight: 600;
}
QFrame#controlPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #142139, stop:1 #101a2b);
    border: 1px solid #293a54;
    border-radius: 14px;
}
QLabel#labelParameters { color: #b7c9e3; font-size: 11px; font-weight: 600; }
QLabel#labelAx, QLabel#labelAy { color: #9eafc8; font-size: 12px; }
QLabel#labelModelInfo { color: #91a5c3; font-size: 11px; }
QFrame#divider { color: #2c3c54; background: #2c3c54; border: none; max-height: 1px; }
QLineEdit {
    background: #0b1526;
    border: 1px solid #344b6c;
    border-radius: 8px;
    padding: 0 10px;
    font-size: 16px;
    selection-background-color: #355f94;
    selection-color: #ffffff;
}
QLineEdit:focus { border: 1px solid #74b3ff; background: #11213a; }
QLineEdit:disabled { color: #879ebd; background: #121d30; border-color: #263a55; }
QLineEdit[invalid="true"] { border: 1px solid #f18d94; background: #2b1d2d; }
QPushButton {
    background: #1b2d48;
    border: 1px solid #3b5375;
    border-radius: 8px;
    padding: 7px 10px;
    font-weight: 600;
}
QPushButton:hover { background: #243d5f; border-color: #7599c9; }
QPushButton:pressed { background: #13243e; border-color: #a1c6f7; }
QPushButton:focus { border: 1px solid #bed8ff; }
QPushButton#btnStart {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #529df8, stop:1 #397be2);
    color: #ffffff;
    border-color: #68aaff;
}
QPushButton#btnStart:hover { background: #64a8ff; }
QPushButton#btnStart:pressed { background: #316bcc; }
QPushButton#btnCorrect { color: #83ecc1; background: #18382f; border-color: #397460; }
QPushButton#btnCorrect:hover { background: #20503e; border-color: #6cdfb3; }
QPushButton#btnCorrect:pressed { background: #112d24; }
QPushButton#btnReset { background: transparent; color: #9fb2cd; border-color: transparent; font-weight: 400; }
QPushButton#btnReset:hover { background: #233049; color: #e3edff; }
QPushButton#btnSound { background: #13243a; color: #9bb1d0; font-weight: 400; font-size: 12px; }
QPushButton#btnSound:checked { color: #94d5bd; border-color: #34594f; }
QPushButton#btnSound:hover { background: #1d334e; }
QPushButton:disabled, QPushButton#btnStart:disabled, QPushButton#btnCorrect:disabled, QPushButton#btnSound:disabled {
    color: #758aa6;
    background: #1b2940;
    border-color: #2c405b;
}
QToolTip { color: #e5efff; background: #1b2c46; border: 1px solid #456185; padding: 6px; }
